# Copy this file to `.env` in the app root and fill in real values.
# Never commit a real `.env`. Never put production passwords in this example.

# REQUIRED. One of: local | uat | production
# There is no Host / REMOTE_ADDR auto-detect — set this explicitly.
#
# Local XAMPP development (use this on your machine):
#   SP_APP_ENV=local
#   → uses DB localhost / sp_work / root / (empty password)
#   → ignores SP_DB_* below
#
# UAT or production servers:
#   SP_APP_ENV=uat   or   SP_APP_ENV=production
#   → requires all four SP_DB_* values below (no built-in name/user defaults)
#
# Missing or unknown SP_APP_ENV always fails closed (web HTTP 500 / CLI exit 1).
SP_APP_ENV=local

SP_DB_HOST=your_database_host
SP_DB_NAME=your_database_name
SP_DB_USER=your_database_user
SP_DB_PASS=change_me_to_a_strong_password

# One-time only — used when accounts table is empty (first schema update).
# Omit on servers that already have users. Never commit real values.
# After the first Master Admin can log in, remove these three lines from `.env`.
# SP_BOOTSTRAP_ADMIN_NAME=Admin
# SP_BOOTSTRAP_ADMIN_EMAIL=you@example.com
# SP_BOOTSTRAP_ADMIN_PASSWORD=choose_a_strong_unique_password

# After upload on live:
# 1. Name the file `.env` next to index.php.
# 2. Set SP_APP_ENV=production (or uat) and fill all SP_DB_* for that server.
# 3. On a brand-new empty DB only: set SP_BOOTSTRAP_ADMIN_* temporarily, run update-live-db.php, then remove them.
# 4. Log in as Master Admin → open /update-live-db.php → type UPDATE.
# 5. Hard-refresh the browser (Ctrl+F5).

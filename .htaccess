# ── Text Compression (gzip) ───────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# ── Browser Caching ───────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript        "access plus 7 days"
  ExpiresByType image/png              "access plus 30 days"
  ExpiresByType image/jpeg             "access plus 30 days"
  ExpiresByType image/gif              "access plus 30 days"
  ExpiresByType image/svg+xml          "access plus 30 days"
  ExpiresByType image/x-icon           "access plus 30 days"
  ExpiresByType font/woff2             "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Protect sensitive paths ───────────────────────────────────────────────────
# No directory listings anywhere under the app root (src/, assets/, tests/ … would
# otherwise be browsable and advertise the file layout).
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Application includes, session storage, quarantined scripts
  RewriteRule ^includes/ - [F,L]
  RewriteRule ^storage/ - [F,L]
  RewriteRule ^scripts/ - [F,L]
  # Test scripts are CLI-only but carry no SAPI guard of their own — running one
  # over HTTP would seed/mutate whichever database db.php resolves to.
  RewriteRule ^tests/ - [F,L]
</IfModule>

# Block direct download of SQL dumps / migration SQL and of the Markdown notes
# and briefs that sit in the web root (db.sql, live-db-*.sql, stitch.md, READMEs).
<FilesMatch "\.(sql|md)$">
  Require all denied
  <IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  </IfModule>
</FilesMatch>

# Dotfiles (.env, .git, etc.)
<FilesMatch "^\.">
  Require all denied
  <IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  </IfModule>
</FilesMatch>
